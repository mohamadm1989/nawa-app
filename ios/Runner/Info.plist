	<!-- صلاحيات معرض الصور -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>يحتاج التطبيق للوصول لمعرض الصور لرفع صور المشاريع</string>

	<!-- دعم الاتجاهات -->
	<key>UIRequiresFullScreen</key>
